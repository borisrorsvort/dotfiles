#!/usr/bin/env bash

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SUB_COMMAND_NAME=$2

ARROW="￫"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Get dotfiles dir (so run this script from anywhere)
export DOTFILES_DIR EXTRA_DIR
DOTFILES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && cd .. && pwd )"

sub_help () {
    echo -e "$ARROW Usage: ${YELLOW}$BIN_NAME <command>${NC}"
    echo
    echo "Commands:"
    echo "   help             This help message"
    echo "   install          Run the master install script to bootstrap the system"
    echo "   backup           Dump current brew packages, commit changes, and push to git"
    echo "   clean            Clean up caches (brew, npm, yarn, composer)"
    echo "   symlinks         Run symlinks script"
    echo "   brew             Run brew script"
}

sub_install () {
    . "$DOTFILES_DIR/install/install.sh"
    echo -e "${GREEN}$ARROW Success! Install command finished.${NC}"
}

sub_backup () {
    echo -e "${YELLOW}$ARROW Dumping Homebrew state...${NC}"
    brew leaves > "$DOTFILES_DIR/dots/brewfile.txt"
    brew list --cask > "$DOTFILES_DIR/dots/brewcaskfile.txt"
    
    cd "$DOTFILES_DIR" || exit
    git add .
    
    if git diff --staged --quiet; then
        echo -e "${GREEN}$ARROW No changes to backup!${NC}"
    else
        git commit -m "chore: backup system state"
        git push
        echo -e "${GREEN}$ARROW Success! Backup pushed to GitHub.${NC}"
    fi
}

sub_clean () {
    brew cleanup
    npm cache clean --force
    yarn cache clean
    echo -e "${GREEN}$ARROW Success! Clean command finished.${NC}"
}

sub_symlinks () {
    . "$DOTFILES_DIR/install/symlinks.sh"
    echo -e "${GREEN}$ARROW Success! Symlinks command finished.${NC}"
}

sub_brew () {
    . "$DOTFILES_DIR/install/brew.sh"
    echo -e "${GREEN}$ARROW Success! Brew command finished.${NC}"
}



case $COMMAND_NAME in
    "" | "-h" | "--help")
        sub_help
        ;;
    *)
        shift
        sub_${COMMAND_NAME} $@
        if [ $? = 127 ]; then
            echo -e "${RED}$ARROW Error: '$COMMAND_NAME' is not a known command or has errors.${NC}" >&2
            sub_help
            exit 1
        fi
        ;;
esac
