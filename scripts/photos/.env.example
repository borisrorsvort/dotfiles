# Your primary storage path for raw photo archives
# macOS example: /Volumes/Shootings
# Linux example: /mnt/darkmatter/CameraRoll Raws
RAW_ARCHIVE_PATH=

# Optional: Default path to your camera SD card mount or MTP camera URI
# If unset, the script will automatically scan /run/media, /media, /Volumes, and active MTP mounts
# Note for MTP cameras (e.g. Ricoh GR): Pointing to the camera root URI scans both Internal Memory and Memory Card:
# Linux example: CAMERA_MOUNT_PATH=mtp://RICOH_IMAGING_COMPANY__LTD._RICOH_GR_IV_0017520/
CAMERA_MOUNT_PATH=

# Required for publish command
WATERMARK_PATH=
IMMICH_SERVER=
IMMICH_API_KEY=
